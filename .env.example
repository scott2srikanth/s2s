# Cloudflare D1 UUID returned by: npx wrangler d1 create s2s
D1_DATABASE_ID=replace-with-real-cloudflare-d1-uuid

# Configure these as encrypted deployment secrets; never commit real values.
AUTH_USERNAME=replace-me
AUTH_PASSWORD=replace-me
AUTH_SESSION_SECRET=replace-with-a-long-random-secret
TOTP_ENCRYPTION_KEY=replace-with-a-long-random-secret
